#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval "$("$SCRIPT_DIR/memory-paths")"

usage() {
  cat <<'USAGE'
Usage: memory-wiki [--project PROJECT]

Generates context/wiki/projects/<project>/current-context.md from source records.
USAGE
}

die() {
  printf 'memory-wiki: %s\n' "$*" >&2
  exit 1
}

frontmatter_value() {
  local key=$1 file=$2
  awk -F': ' -v key="$key" '
    $1 == key {
      value=$0
      sub("^[^:]+:[[:space:]]*", "", value)
      gsub(/^"/, "", value)
      gsub(/"$/, "", value)
      print value
      exit
    }
  ' "$file"
}

project=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --project)
      project=${2:-}
      [ -n "$project" ] || die "--project needs a value"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [ -z "$project" ]; then
  project=$("$SCRIPT_DIR/memory-project")
fi

record_dir="$MEMORY_CONTEXT_ROOT/records/projects/$project"
[ -d "$record_dir" ] || die "no records for project '$project'. Fix: run memory-ingest first."

records=$(find "$record_dir" -type f -name '*.md' | sort)
[ -n "$records" ] || die "no records for project '$project'. Fix: run memory-ingest first."

wiki_dir="$MEMORY_CONTEXT_ROOT/wiki/projects/$project"
mkdir -p "$wiki_dir"
target="$wiki_dir/current-context.md"
tmp=$(mktemp "${MEMORY_TMP_ROOT}/memory-wiki.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '# %s Current Context\n\n' "$project"
  printf 'Generated by `memory-wiki` from source records. Do not add uncited factual claims.\n\n'
  printf '## What This Project Is\n\n'
  printf 'This project has %s source record(s) in team memory. [source: %s]\n\n' "$(printf '%s\n' "$records" | wc -l | tr -d ' ')" "$(printf '%s\n' "$records" | head -1 | sed "s|^$MEMORY_REPO_ROOT/||")"
  printf '## Source Records\n\n'
  while IFS= read -r record; do
    title=$(frontmatter_value title "$record")
    date_value=$(frontmatter_value date "$record")
    member=$(frontmatter_value member "$record")
    source_type=$(frontmatter_value source_type "$record")
    rel=${record#"$MEMORY_REPO_ROOT"/}
    printf -- '- %s (%s, %s, %s) [source: %s]\n' "${title:-Untitled}" "${date_value:-unknown date}" "${source_type:-unknown source}" "${member:-unknown member}" "$rel"
  done <<< "$records"
  printf '\n## Open Questions\n\n'
  printf '%s\n\n' '- No open questions have been synthesized yet. Add source records first, then let an agent update this section with citations.'
  printf '## Watchouts\n\n'
  printf '%s\n\n' '- Keep this wiki short and reloadable. Store raw detail in records, not here.'
  printf '## Sources\n\n'
  while IFS= read -r record; do
    rel=${record#"$MEMORY_REPO_ROOT"/}
    printf -- '- [source: %s]\n' "$rel"
  done <<< "$records"
} > "$tmp"

mv "$tmp" "$target"
printf '%s\n' "$target"
