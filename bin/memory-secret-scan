#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if git rev-parse --show-toplevel >/dev/null 2>&1; then
  eval "$("$SCRIPT_DIR/memory-paths")"
else
  MEMORY_REPO_ROOT=$(pwd)
  MEMORY_CONTEXT_ROOT=${TEAM_MEMORY_CONTEXT_ROOT:-"$MEMORY_REPO_ROOT/context"}
  MEMORY_POLICY_ROOT="$MEMORY_CONTEXT_ROOT/policies"
fi

usage() {
  cat <<'USAGE'
Usage: memory-secret-scan [file ...]

Scans files for likely credentials and team-configured denylist markers. With no
arguments, scans the working tree excluding .git and common generated folders.
USAGE
}

die() {
  printf 'memory-secret-scan: %s\n' "$*" >&2
  exit 1
}

is_policy_file() {
  case "$1" in
    context/policies/*|docs/*|README.md|AGENTS.md|bin/memory-secret-scan|tests/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

scan_denylist() {
  local file=$1 rel=$2 failed=0 denylist line
  denylist="$MEMORY_POLICY_ROOT/denylist.txt"
  [ -f "$denylist" ] || return 0
  is_policy_file "$rel" && return 0

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    if grep -nF "$line" "$file" >"${MEMORY_TMP_ROOT:-/tmp}/memory-denylist-lines.$$" 2>/dev/null; then
      sed "s|^|$rel:denylist '$line':|" "${MEMORY_TMP_ROOT:-/tmp}/memory-denylist-lines.$$" >&2
      failed=1
    fi
  done < "$denylist"
  rm -f "${MEMORY_TMP_ROOT:-/tmp}/memory-denylist-lines.$$"
  return "$failed"
}

scan_file() {
  local file=$1 rel failed=0 tmp
  [ -f "$file" ] || return 0
  rel=${file#"$MEMORY_REPO_ROOT"/}
  rel=${rel#./}
  tmp="${MEMORY_TMP_ROOT:-/tmp}/memory-secret-lines.$$"

  if grep -nE '(API_KEY|ACCESS_TOKEN|SECRET|PASSWORD|PRIVATE_KEY|TOKEN)[[:space:]]*=[[:space:]]*["'\'']?[A-Za-z0-9_./+=:-]{12,}' "$file" >"$tmp" 2>/dev/null; then
    if ! grep -Eq '\[REDACTED\]|<[^>]+>|\.\.\.|example|dummy|changeme' "$tmp"; then
      sed "s|^|$rel:|" "$tmp" >&2
      failed=1
    fi
  fi

  if grep -nE '(sk-[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY)' "$file" >"$tmp" 2>/dev/null; then
    sed "s|^|$rel:|" "$tmp" >&2
    failed=1
  fi

  scan_denylist "$file" "$rel" || failed=1
  rm -f "$tmp"
  return "$failed"
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

failed=0
if [ "$#" -gt 0 ]; then
  for file in "$@"; do
    scan_file "$file" || failed=1
  done
else
  while IFS= read -r file; do
    scan_file "$file" || failed=1
  done < <(find "$MEMORY_REPO_ROOT" \
    \( -path "$MEMORY_REPO_ROOT/.git" -o -path "$MEMORY_REPO_ROOT/.git/*" -o -path "$MEMORY_REPO_ROOT/node_modules" -o -path "$MEMORY_REPO_ROOT/node_modules/*" -o -path "$MEMORY_REPO_ROOT/.venv" -o -path "$MEMORY_REPO_ROOT/.venv/*" \) -prune \
    -o -type f -print | sort)
fi

if [ "$failed" -ne 0 ]; then
  die "scan failed. Fix: redact secrets/private context and rerun."
fi

printf 'secret scan ok\n'
