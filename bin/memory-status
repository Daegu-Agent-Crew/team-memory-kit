#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval "$("$SCRIPT_DIR/memory-paths")"

project_output="$("$SCRIPT_DIR/memory-project" --shell 2>/dev/null || true)"
if [ -n "$project_output" ]; then
  eval "$project_output"
else
  MEMORY_PROJECT="unresolved"
  MEMORY_PROJECT_SOURCE="unresolved"
  MEMORY_PROJECT_MATCH="unresolved"
  MEMORY_REPO_SLUG="unresolved"
fi

printf 'MEMORY_REPO_ROOT=%s\n' "$MEMORY_REPO_ROOT"
printf 'MEMORY_CONTEXT_ROOT=%s\n' "$MEMORY_CONTEXT_ROOT"
printf 'MEMORY_HOME=%s\n' "$MEMORY_HOME"
if [ -f "$MEMORY_REPO_ROOT/VERSION" ]; then
  printf 'TEAM_MEMORY_KIT_VERSION=%s\n' "$(sed -n '1p' "$MEMORY_REPO_ROOT/VERSION")"
else
  printf 'TEAM_MEMORY_KIT_VERSION=missing\n'
fi
if [ -f "$MEMORY_REPO_ROOT/MEMORY_VERSION" ]; then
  memory_version_value() {
    awk -F ':' -v key="$1" '
      $1 == key {
        value = $0
        sub("^[^:]+:[[:space:]]*", "", value)
        print value
        exit
      }
    ' "$MEMORY_REPO_ROOT/MEMORY_VERSION"
  }
  printf 'MEMORY_VERSION_UPDATED_AT=%s\n' "$(memory_version_value updated_at)"
  printf 'MEMORY_VERSION_UPDATED_BY=%s\n' "$(memory_version_value updated_by)"
  printf 'MEMORY_VERSION_SYNC_MODE=%s\n' "$(memory_version_value sync_mode)"
  printf 'MEMORY_VERSION_SYNC_SCOPE=%s\n' "$(memory_version_value sync_scope)"
else
  printf 'MEMORY_VERSION=missing\n'
fi
printf 'MEMORY_PROJECT=%s\n' "$MEMORY_PROJECT"
printf 'MEMORY_PROJECT_SOURCE=%s\n' "$MEMORY_PROJECT_SOURCE"
printf 'MEMORY_PROJECT_MATCH=%s\n' "$MEMORY_PROJECT_MATCH"
printf 'MEMORY_REPO_SLUG=%s\n' "$MEMORY_REPO_SLUG"

origin=$(git -C "$MEMORY_REPO_ROOT" remote get-url origin 2>/dev/null || true)
if [ -n "$origin" ]; then
  printf 'ORIGIN=%s\n' "$origin"
else
  printf 'ORIGIN=missing\n'
fi

if [ -L "$MEMORY_HOME" ]; then
  printf 'HOME_LINK=%s\n' "$(readlink "$MEMORY_HOME")"
elif [ -e "$MEMORY_HOME" ]; then
  printf 'HOME_LINK=not-a-symlink\n'
else
  printf 'HOME_LINK=missing\n'
fi

printf '\nVerification:\n'
if verify_output="$("$SCRIPT_DIR/memory-verify" 2>&1)"; then
  printf 'memory-verify: ok\n'
else
  [ -z "$verify_output" ] || printf '%s\n' "$verify_output"
  printf 'memory-verify: failed\n'
fi

printf '\nGit status:\n'
git -C "$MEMORY_REPO_ROOT" status --short || true

printf '\nRecent records:\n'
record_dir="$MEMORY_CONTEXT_ROOT/records/projects/$MEMORY_PROJECT"
if [ "$MEMORY_PROJECT" != "unresolved" ] && [ -d "$record_dir" ]; then
  find "$record_dir" -type f -name '*.md' 2>/dev/null | sort | tail -10 | sed "s|^$MEMORY_REPO_ROOT/||"
else
  printf 'none\n'
fi

printf '\nWiki files:\n'
wiki_dir="$MEMORY_CONTEXT_ROOT/wiki/projects/$MEMORY_PROJECT"
if [ "$MEMORY_PROJECT" != "unresolved" ] && [ -d "$wiki_dir" ]; then
  find "$wiki_dir" -type f -name '*.md' 2>/dev/null | sort | sed "s|^$MEMORY_REPO_ROOT/||"
else
  printf 'none\n'
fi
