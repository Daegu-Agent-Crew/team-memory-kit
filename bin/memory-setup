#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval "$("$SCRIPT_DIR/memory-paths")"

status=0

check_cmd() {
  if command -v "$1" >/dev/null 2>&1; then
    printf 'ok: %s\n' "$1"
  else
    printf 'missing: %s. Fix: install %s and retry.\n' "$1" "$1" >&2
    status=1
  fi
}

check_cmd git
check_cmd rg
check_cmd jq

if [ -d "$MEMORY_CONTEXT_ROOT" ]; then
  printf 'ok: context root exists: %s\n' "${MEMORY_CONTEXT_ROOT#"$MEMORY_REPO_ROOT"/}"
else
  printf 'missing: context root: %s\n' "${MEMORY_CONTEXT_ROOT#"$MEMORY_REPO_ROOT"/}" >&2
  status=1
fi

if [ -f "$MEMORY_MEMBER_FILE" ]; then
  member_count=$(awk '/^[[:space:]]*-[[:space:]]*/ { count++ } END { print count + 0 }' "$MEMORY_MEMBER_FILE")
  if [ "$member_count" -gt 0 ]; then
    printf 'ok: %s has %s member(s)\n' "${MEMORY_MEMBER_FILE#"$MEMORY_REPO_ROOT"/}" "$member_count"
  else
    printf 'needs setup: add GitHub usernames to %s\n' "${MEMORY_MEMBER_FILE#"$MEMORY_REPO_ROOT"/}" >&2
    status=1
  fi
else
  printf 'missing: %s\n' "${MEMORY_MEMBER_FILE#"$MEMORY_REPO_ROOT"/}" >&2
  status=1
fi

"$SCRIPT_DIR/memory-project" --validate >/dev/null && printf 'ok: registry validates\n' || status=1

exit "$status"
