#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
DEFAULT_SOURCE=$(cd "$SCRIPT_DIR/.." && pwd)
PRODUCT_COMMAND=memory-upgrade
source "$SCRIPT_DIR/memory-lib-product"

source_root=${TEAM_MEMORY_KIT_ROOT:-"$DEFAULT_SOURCE"}
dry_run=0
target=""

usage() {
  cat >&2 <<'USAGE'
Usage: memory-upgrade [--source <kit-repo>] [--dry-run] <team-memory-repo>

Upgrades product-owned team-memory-kit files in a private team memory repo:
PRODUCT_MANIFEST, VERSION, setup, bin/memory-*, and skills/tm-*.

It does not touch context/, MEMORY_VERSION, member allowlists, registries, or
share drafts. Run from a team-memory-kit checkout, or pass --source when running
from an existing private team memory repo.
USAGE
}

die() {
  printf 'memory-upgrade: %s\n' "$*" >&2
  exit 1
}

canonical_dir() {
  dir=$1
  [ -d "$dir" ] || return 1
  (cd "$dir" >/dev/null 2>&1 && pwd -P)
}

version_value() {
  file=$1
  if [ -f "$file" ]; then
    sed -n '1p' "$file"
  else
    printf 'missing\n'
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --source)
      source_root=${2:?Missing value for --source}
      shift 2
      ;;
    --source=*)
      source_root=${1#--source=}
      shift
      ;;
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      printf 'memory-upgrade: unknown argument: %s\n' "$1" >&2
      usage
      exit 2
      ;;
    *)
      if [ -z "$target" ]; then
        target=$1
        shift
      else
        printf 'memory-upgrade: unexpected argument: %s\n' "$1" >&2
        usage
        exit 2
      fi
      ;;
  esac
done

[ -n "$target" ] || { usage; exit 2; }

source_root=$(canonical_dir "$source_root") || die "source kit repo does not exist: $source_root"
target_root=$(canonical_dir "$target") || die "target team memory repo does not exist: $target"

[ "$source_root" != "$target_root" ] || die "source and target are the same. Run from a team-memory-kit checkout or pass --source <kit-repo>."
[ -f "$source_root/VERSION" ] || die "source is missing VERSION: $source_root"
[ -f "$source_root/PRODUCT_MANIFEST" ] || die "source is missing PRODUCT_MANIFEST: $source_root"
[ -d "$source_root/bin" ] || die "source is missing bin/: $source_root"
[ -d "$source_root/skills" ] || die "source is missing skills/: $source_root"
[ -f "$source_root/setup" ] || die "source is missing setup: $source_root"
[ -f "$target_root/MEMORY_VERSION" ] || die "target does not look like a private team memory repo; missing MEMORY_VERSION: $target_root"
[ -d "$target_root/context" ] || die "target does not look like a private team memory repo; missing context/: $target_root"

manifest_tmp=$(mktemp "${TMPDIR:-/tmp}/memory-upgrade-manifest.XXXXXX")
stale_tmp=$(mktemp "${TMPDIR:-/tmp}/memory-upgrade-stale.XXXXXX")
trap 'rm -f "$manifest_tmp" "$stale_tmp"' EXIT

product_manifest_entries "$source_root" > "$manifest_tmp"
product_require_manifest_sources "$source_root" "$manifest_tmp"
product_stale_entries "$target_root" "$manifest_tmp" | sort -u > "$stale_tmp"

source_version=$(version_value "$source_root/VERSION")
target_version=$(version_value "$target_root/VERSION")

printf 'memory-upgrade: source=%s\n' "$source_root"
printf 'memory-upgrade: target=%s\n' "$target_root"
printf 'memory-upgrade: current VERSION=%s\n' "$target_version"
printf 'memory-upgrade: source VERSION=%s\n' "$source_version"

if [ "$dry_run" -eq 1 ]; then
  printf '\nWould update:\n'
  sed 's/^/- /' "$manifest_tmp"
  printf '\nWould prune stale product files:\n'
  if [ -s "$stale_tmp" ]; then sed 's/^/- /' "$stale_tmp"; else printf '%s\n' '- none'; fi
  printf '\nWould not touch:\n'
  printf '%s\n' '- context/'
  printf '%s\n' '- MEMORY_VERSION'
  printf '%s\n' '- .github/team-memory-members.yml'
  exit 0
fi

product_copy_manifest_entries "$source_root" "$target_root" "$manifest_tmp"
product_prune_stale_entries "$target_root" "$stale_tmp"

chmod +x "$target_root"/bin/memory-* "$target_root/setup"

if ! "$target_root/bin/memory-verify"; then
  die "upgrade copied product files, but verification failed. Fix verification issues before syncing."
fi

printf 'memory-upgrade: upgraded from %s to %s\n' "$target_version" "$source_version"
