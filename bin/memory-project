#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval "$("$SCRIPT_DIR/memory-paths")"

usage() {
  cat <<'USAGE'
Usage: memory-project [--repo owner/name-or-slug] [--validate] [--shell]

Resolves a Git repository slug or alias to a team memory project.
USAGE
}

die() {
  printf 'memory-project: %s\n' "$*" >&2
  exit 1
}

quote_sh() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

repo_arg=""
validate_only=0
shell_output=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      repo_arg=${2:-}
      [ -n "$repo_arg" ] || die "--repo needs a value"
      shift 2
      ;;
    --validate)
      validate_only=1
      shift
      ;;
    --shell)
      shell_output=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

remote_slug() {
  local url slug
  url=$(git -C "$MEMORY_REPO_ROOT" remote get-url origin 2>/dev/null || true)
  if [ -n "$url" ]; then
    case "$url" in
      git@*:*) slug=${url#*:} ;;
      https://*/*/*|http://*/*/*) slug=${url#*://*/} ;;
      *) slug=$url ;;
    esac
    slug=${slug%.git}
    printf '%s\n' "$slug"
    return 0
  fi
  basename "$MEMORY_REPO_ROOT"
}

if [ -n "${TEAM_MEMORY_PROJECT:-}" ]; then
  if [ "$validate_only" = "1" ]; then
    printf 'registry ok\n'
    exit 0
  fi
  if [ "$shell_output" = "1" ]; then
    printf 'MEMORY_PROJECT=%s\n' "$(quote_sh "$TEAM_MEMORY_PROJECT")"
    printf 'MEMORY_PROJECT_SOURCE=%s\n' "'env'"
    printf 'MEMORY_PROJECT_MATCH=%s\n' "'env'"
    printf 'MEMORY_REPO_SLUG=%s\n' "$(quote_sh "${repo_arg:-$(remote_slug)}")"
  else
    printf '%s\n' "$TEAM_MEMORY_PROJECT"
  fi
  exit 0
fi

if ! "$SCRIPT_DIR/memory-lib-registry" validate >/dev/null; then
  "$SCRIPT_DIR/memory-lib-registry" validate >&2 || true
  exit 1
fi

if [ "$validate_only" = "1" ]; then
  printf 'registry ok\n'
  exit 0
fi

target=${repo_arg:-$(remote_slug)}
[ -n "$target" ] || die "could not determine repository slug. Fix: set origin or pass --repo owner/name."

resolved=$("$SCRIPT_DIR/memory-lib-registry" resolve-repo "$target" 2>/dev/null || true)
if [ -z "$resolved" ]; then
  die "project unresolved for repo '$target'. Fix: add registry metadata or pass TEAM_MEMORY_PROJECT after explicit user confirmation."
fi
eval "$resolved"
project=$MEMORY_REGISTRY_PROJECT
match_type=$MEMORY_REGISTRY_MATCH

if [ "$shell_output" = "1" ]; then
  printf 'MEMORY_PROJECT=%s\n' "$(quote_sh "$project")"
  printf 'MEMORY_PROJECT_SOURCE=%s\n' "'registry'"
  printf 'MEMORY_PROJECT_MATCH=%s\n' "$(quote_sh "$match_type")"
  printf 'MEMORY_REPO_SLUG=%s\n' "$(quote_sh "$target")"
else
  printf '%s\n' "$project"
fi
