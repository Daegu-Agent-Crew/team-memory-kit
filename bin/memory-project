#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval "$("$SCRIPT_DIR/memory-paths")"

usage() {
  cat <<'USAGE'
Usage: memory-project [--repo owner/name-or-slug] [--validate] [--shell]

Resolves a Git repository slug or alias to a team memory project.
USAGE
}

die() {
  printf 'memory-project: %s\n' "$*" >&2
  exit 1
}

quote_sh() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

repo_arg=""
validate_only=0
shell_output=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      repo_arg=${2:-}
      [ -n "$repo_arg" ] || die "--repo needs a value"
      shift 2
      ;;
    --validate)
      validate_only=1
      shift
      ;;
    --shell)
      shell_output=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

remote_slug() {
  local url slug
  url=$(git -C "$MEMORY_REPO_ROOT" remote get-url origin 2>/dev/null || true)
  if [ -n "$url" ]; then
    case "$url" in
      git@*:*) slug=${url#*:} ;;
      https://*/*/*|http://*/*/*) slug=${url#*://*/} ;;
      *) slug=$url ;;
    esac
    slug=${slug%.git}
    printf '%s\n' "$slug"
    return 0
  fi
  basename "$MEMORY_REPO_ROOT"
}

project_exists() {
  [ -f "$MEMORY_REGISTRY_ROOT/projects/$1.yml" ]
}

emit_mappings() {
  local file slug project in_aliases line alias
  find "$MEMORY_REGISTRY_ROOT/repositories" -type f -name '*.yml' 2>/dev/null | sort | while IFS= read -r file; do
    slug=""
    project=""
    in_aliases=0
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        slug:*)
          slug=${line#slug:}
          slug=${slug#"${slug%%[![:space:]]*}"}
          slug=${slug%"${slug##*[![:space:]]}"}
          slug=${slug#\"}
          slug=${slug%\"}
          in_aliases=0
          ;;
        project:*)
          project=${line#project:}
          project=${project#"${project%%[![:space:]]*}"}
          project=${project%"${project##*[![:space:]]}"}
          project=${project#\"}
          project=${project%\"}
          in_aliases=0
          ;;
        aliases:*)
          in_aliases=1
          ;;
        "  - "*|"- "*)
          if [ "$in_aliases" = "1" ]; then
            alias=${line#*- }
            alias=${alias#"${alias%%[![:space:]]*}"}
            alias=${alias%"${alias##*[![:space:]]}"}
            alias=${alias#\"}
            alias=${alias%\"}
            [ -n "$alias" ] && printf '%s|%s|alias|%s\n' "$alias" "${project:-$slug}" "$file"
          fi
          ;;
        *)
          in_aliases=0
          ;;
      esac
    done < "$file"
    [ -n "$slug" ] || die "repository registry missing slug: ${file#"$MEMORY_REPO_ROOT"/}"
    [ -n "${project:-$slug}" ] || die "repository registry missing project: ${file#"$MEMORY_REPO_ROOT"/}"
    printf '%s|%s|slug|%s\n' "$slug" "${project:-$slug}" "$file"
  done
}

if [ -n "${TEAM_MEMORY_PROJECT:-}" ]; then
  if [ "$validate_only" = "1" ]; then
    printf 'registry ok\n'
    exit 0
  fi
  if [ "$shell_output" = "1" ]; then
    printf 'MEMORY_PROJECT=%s\n' "$(quote_sh "$TEAM_MEMORY_PROJECT")"
    printf 'MEMORY_PROJECT_SOURCE=%s\n' "'env'"
    printf 'MEMORY_PROJECT_MATCH=%s\n' "'env'"
    printf 'MEMORY_REPO_SLUG=%s\n' "$(quote_sh "${repo_arg:-$(remote_slug)}")"
  else
    printf '%s\n' "$TEAM_MEMORY_PROJECT"
  fi
  exit 0
fi

tmp=$(mktemp "${MEMORY_TMP_ROOT}/memory-project.XXXXXX")
trap 'rm -f "$tmp"' EXIT
emit_mappings > "$tmp"

if [ ! -s "$tmp" ]; then
  die "no repository registry files found. Fix: add context/registry/repositories/<repo>.yml."
fi

errors=0
while IFS='|' read -r key project _match _file; do
  [ -n "$key" ] || continue
  count=$(awk -F'|' -v k="$key" '$1 == k { print $2 }' "$tmp" | sort -u | wc -l | tr -d ' ')
  if [ "$count" -gt 1 ]; then
    printf 'memory-project: alias maps to multiple projects: %s\n' "$key" >&2
    errors=$((errors + 1))
  fi
  if ! project_exists "$project"; then
    printf 'memory-project: project metadata missing for %s\n' "$project" >&2
    errors=$((errors + 1))
  fi
done < "$tmp"

if [ "$errors" -gt 0 ]; then
  exit 1
fi

if [ "$validate_only" = "1" ]; then
  printf 'registry ok\n'
  exit 0
fi

target=${repo_arg:-$(remote_slug)}
[ -n "$target" ] || die "could not determine repository slug. Fix: set origin or pass --repo owner/name."

match=$(awk -F'|' -v k="$target" '$1 == k { print $0 }' "$tmp" | sort -u)
if [ -z "$match" ]; then
  die "project unresolved for repo '$target'. Fix: add registry metadata or pass TEAM_MEMORY_PROJECT after explicit user confirmation."
fi

projects=$(printf '%s\n' "$match" | awk -F'|' '{ print $2 }' | sort -u)
if [ "$(printf '%s\n' "$projects" | wc -l | tr -d ' ')" -gt 1 ]; then
  die "project ambiguous for repo '$target'. Fix duplicate registry aliases."
fi

project=$(printf '%s\n' "$match" | awk -F'|' 'NR == 1 { print $2 }')
match_type=$(printf '%s\n' "$match" | awk -F'|' 'NR == 1 { print $3 }')

if [ "$shell_output" = "1" ]; then
  printf 'MEMORY_PROJECT=%s\n' "$(quote_sh "$project")"
  printf 'MEMORY_PROJECT_SOURCE=%s\n' "'registry'"
  printf 'MEMORY_PROJECT_MATCH=%s\n' "$(quote_sh "$match_type")"
  printf 'MEMORY_REPO_SLUG=%s\n' "$(quote_sh "$target")"
else
  printf '%s\n' "$project"
fi
