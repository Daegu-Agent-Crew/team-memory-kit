#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
range="HEAD"

usage() {
  echo "Usage: memory-commit-policy-check [--range <git-rev-range>]" >&2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --range) range=${2:?Missing value for --range}; shift 2 ;;
    --range=*) range=${1#--range=}; shift ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'memory-commit-policy-check: unknown argument: %s\n' "$1" >&2; usage; exit 2 ;;
  esac
done

members_file="$repo/.github/team-memory-members.yml"
memory_version_file="$repo/MEMORY_VERSION"
errors=0
last_member=""
last_updated_at=""
last_scope=""
last_mode=""

field_value() {
  file=$1
  key=$2
  awk -F ':' -v key="$key" '
    $1 == key {
      value = $0
      sub("^[^:]+:[[:space:]]*", "", value)
      gsub(/^"/, "", value)
      gsub(/"$/, "", value)
      print value
      exit
    }
  ' "$file"
}

member_ids() {
  [ -f "$members_file" ] || return 0
  awk '
    /^[[:space:]]*-[[:space:]]*/ {
      value=$0
      sub(/^[[:space:]]*-[[:space:]]*/, "", value)
      gsub(/[[:space:]]+$/, "", value)
      print value
    }
  ' "$members_file"
}

member_is_allowed() {
  member_ids | awk -v id="$1" '$0 == id { found = 1 } END { exit found ? 0 : 1 }'
}

trailer_value() {
  message=$1
  key=$2
  printf '%s\n' "$message" | awk -v key="$key" '
    $0 ~ "^" key ":[[:space:]]*" {
      value = $0
      sub("^" key ":[[:space:]]*", "", value)
      found = value
    }
    END { if (found != "") print found }
  '
}

is_context_commit() {
  commit=$1
  git -C "$repo" diff-tree --root --no-commit-id --name-only -r "$commit" | awk '
    $0 == "MEMORY_VERSION" { found = 1 }
    $0 ~ /^context\// { found = 1 }
    END { exit found ? 0 : 1 }
  '
}

is_template_initial_commit() {
  commit=$1
  parent_line=$(git -C "$repo" rev-list --parents -n 1 "$commit" 2>/dev/null || true)
  [ "$(printf '%s\n' "$parent_line" | wc -w | tr -d ' ')" = "1" ] || return 1
  updated_via=$(git -C "$repo" show "$commit:MEMORY_VERSION" 2>/dev/null | awk -F ':' '$1 == "updated_via" { value=$0; sub("^[^:]+:[[:space:]]*", "", value); print value; exit }' || true)
  [ "$updated_via" = "template" ]
}

validate_member() {
  commit=$1
  value=$2
  if [ -z "$value" ]; then
    echo "$commit: missing Team-Memory-Member trailer" >&2
    errors=1
    return
  fi
  if ! printf '%s\n' "$value" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$'; then
    echo "$commit: Team-Memory-Member must be a GitHub username: $value" >&2
    errors=1
    return
  fi
  if [ ! -f "$members_file" ]; then
    echo "$commit: missing member allowlist: .github/team-memory-members.yml" >&2
    errors=1
    return
  fi
  if ! member_is_allowed "$value"; then
    echo "$commit: unknown Team-Memory-Member '$value'" >&2
    errors=1
  fi
}

validate_timestamp() {
  commit=$1
  value=$2
  if [ -z "$value" ]; then
    echo "$commit: missing Team-Memory-Updated-At trailer" >&2
    errors=1
    return
  fi
  if ! printf '%s\n' "$value" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$'; then
    echo "$commit: invalid Team-Memory-Updated-At timestamp: $value" >&2
    errors=1
  fi
}

validate_mode() {
  commit=$1
  value=$2
  case "$value" in
    project|paths|all) ;;
    "")
      echo "$commit: missing Team-Memory-Sync-Mode trailer" >&2
      errors=1
      ;;
    *)
      echo "$commit: invalid Team-Memory-Sync-Mode: $value" >&2
      errors=1
      ;;
  esac
}

if [ ! -f "$members_file" ]; then
  echo "missing member allowlist: .github/team-memory-members.yml" >&2
  errors=1
fi

case "$range" in
  *..*)
    if ! commits=$(git -C "$repo" rev-list --reverse "$range" 2>/dev/null); then
      echo "memory-commit-policy-check: invalid or unavailable range: $range" >&2
      exit 2
    fi
    ;;
  *)
    if ! commits=$(git -C "$repo" rev-parse --verify "$range" 2>/dev/null); then
      echo "memory-commit-policy-check: invalid or unavailable revision: $range" >&2
      exit 2
    fi
    ;;
esac

if [ -z "$commits" ]; then
  echo "memory-commit-policy-check: no commits found for range: $range" >&2
  exit 0
fi

while IFS= read -r commit; do
  [ -n "$commit" ] || continue
  if ! is_context_commit "$commit"; then
    continue
  fi
  if is_template_initial_commit "$commit"; then
    continue
  fi

  message=$(git -C "$repo" show -s --format=%B "$commit")
  member=$(trailer_value "$message" Team-Memory-Member)
  updated_at=$(trailer_value "$message" Team-Memory-Updated-At)
  scope=$(trailer_value "$message" Team-Memory-Scope)
  mode=$(trailer_value "$message" Team-Memory-Sync-Mode)

  validate_member "$commit" "$member"
  validate_timestamp "$commit" "$updated_at"
  validate_mode "$commit" "$mode"
  if [ -z "$scope" ]; then
    echo "$commit: missing Team-Memory-Scope trailer" >&2
    errors=1
  fi

  last_member=$member
  last_updated_at=$updated_at
  last_scope=$scope
  last_mode=$mode
done <<EOF_COMMITS
$commits
EOF_COMMITS

if [ -n "$last_member" ]; then
  if [ ! -f "$memory_version_file" ]; then
    echo "MEMORY_VERSION: missing file" >&2
    errors=1
  else
    schema_version=$(field_value "$memory_version_file" schema_version)
    snapshot_date=$(field_value "$memory_version_file" snapshot_date)
    updated_at=$(field_value "$memory_version_file" updated_at)
    updated_by=$(field_value "$memory_version_file" updated_by)
    updated_via=$(field_value "$memory_version_file" updated_via)
    sync_mode=$(field_value "$memory_version_file" sync_mode)
    sync_scope=$(field_value "$memory_version_file" sync_scope)
    expected_date=${last_updated_at%%T*}

    [ "$schema_version" = "1" ] || { echo "MEMORY_VERSION: schema_version must be 1" >&2; errors=1; }
    [ "$snapshot_date" = "$expected_date" ] || { echo "MEMORY_VERSION: snapshot_date does not match latest context timestamp" >&2; errors=1; }
    [ "$updated_at" = "$last_updated_at" ] || { echo "MEMORY_VERSION: updated_at does not match latest context commit trailer" >&2; errors=1; }
    [ "$updated_by" = "$last_member" ] || { echo "MEMORY_VERSION: updated_by does not match latest context commit member" >&2; errors=1; }
    [ "$updated_via" = "memory-sync" ] || { echo "MEMORY_VERSION: updated_via must be memory-sync" >&2; errors=1; }
    [ "$sync_mode" = "$last_mode" ] || { echo "MEMORY_VERSION: sync_mode does not match latest context commit trailer" >&2; errors=1; }
    [ "$sync_scope" = "$last_scope" ] || { echo "MEMORY_VERSION: sync_scope does not match latest context commit trailer" >&2; errors=1; }
  fi
fi

[ "$errors" -eq 0 ]
