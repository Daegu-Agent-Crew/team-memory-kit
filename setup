#!/usr/bin/env bash
set -euo pipefail
umask 077

SOURCE_DIR="$(cd "$(dirname "$0")" >/dev/null 2>&1 && pwd -P)"
HOST="codex"
STATE_MODE="symlink"
REPAIR=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host) HOST="${2:?Missing value for --host}"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --state) STATE_MODE="${2:?Missing value for --state}"; shift 2 ;;
    --state=*) STATE_MODE="${1#--state=}"; shift ;;
    --repair) REPAIR=1; shift ;;
    -h|--help)
      echo "Usage: ./setup [--host codex|claude|auto] [--state symlink|none] [--repair]" >&2
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
done

case "$HOST" in
  codex|claude|auto) ;;
  *) echo "Unknown host: $HOST" >&2; exit 2 ;;
esac

case "$STATE_MODE" in
  symlink|none) ;;
  *) echo "Unknown state mode: $STATE_MODE" >&2; exit 2 ;;
esac

fail_setup() {
  echo "setup: $*" >&2
  exit 1
}

canonical_path() {
  path="$1"
  if [ -d "$path" ]; then
    (cd -P "$path" >/dev/null 2>&1 && pwd -P)
  elif [ -e "$path" ]; then
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    printf '%s/%s\n' "$(cd -P "$dir" >/dev/null 2>&1 && pwd -P)" "$base"
  else
    return 1
  fi
}

resolve_link_path() {
  link_path="$1"
  target="$(readlink "$link_path")" || return 1
  case "$target" in
    /*) target_path="$target" ;;
    *) target_path="$(cd -P "$(dirname "$link_path")" >/dev/null 2>&1 && pwd -P)/$target" ;;
  esac
  canonical_path "$target_path"
}

backup_non_link() {
  path="$1"
  stamp="$(date +%Y%m%d%H%M%S 2>/dev/null || echo unknown)"
  backup="${path}.team-memory-broken.${stamp}.$$"
  i=0
  while [ -e "$backup" ]; do
    i=$((i + 1))
    backup="${path}.team-memory-broken.${stamp}.$$.$i"
  done
  mv "$path" "$backup"
  echo "repaired non-link path: $path -> $backup"
}

create_link() {
  target="$1"
  link_path="$2"
  expected="$(canonical_path "$target")" || fail_setup "link target does not exist: $target"
  mkdir -p "$(dirname "$link_path")"

  if [ -L "$link_path" ]; then
    actual="$(resolve_link_path "$link_path" 2>/dev/null || true)"
    if [ "$actual" = "$expected" ]; then
      return 0
    fi
    rm -f "$link_path"
  elif [ -e "$link_path" ]; then
    if [ "$REPAIR" -eq 1 ]; then
      backup_non_link "$link_path"
    else
      fail_setup "$link_path exists but is not a link. Re-run with --repair to move the broken path aside and recreate team-memory links."
    fi
  fi

  if ! MSYS=winsymlinks:nativestrict ln -s "$target" "$link_path"; then
    fail_setup "could not create link: $link_path -> $target. On Windows, enable Developer Mode or run from an elevated Git Bash, then retry."
  fi

  actual="$(resolve_link_path "$link_path" 2>/dev/null || true)"
  if [ -z "$actual" ] || [ "$actual" != "$expected" ]; then
    rm -f "$link_path"
    fail_setup "created invalid link: $link_path -> ${actual:-unresolvable}, expected $expected. On Windows, Git Bash needs MSYS=winsymlinks:nativestrict and symlink permission."
  fi
}

cleanup_legacy_skill_links() {
  skills_dir="$1"
  legacy="$skills_dir/team-memory"
  if [ -L "$legacy" ]; then
    rm -f "$legacy"
    echo "removed legacy skill link: team-memory"
  fi
}

if [ "$STATE_MODE" = "symlink" ]; then
  MEMORY_HOME="${TEAM_MEMORY_HOME:-$HOME/.team-memory}"
  create_link "$SOURCE_DIR/context" "$MEMORY_HOME"
fi

install_codex() {
  skills_dir="$HOME/.codex/skills"
  mkdir -p "$skills_dir"
  cleanup_legacy_skill_links "$skills_dir"
  for skill_dir in "$SOURCE_DIR"/skills/tm-*; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    name="$(basename "$skill_dir")"
    create_link "$skill_dir" "$skills_dir/$name"
    echo "linked Codex skill: $name"
  done
}

install_claude() {
  skills_dir="$HOME/.claude/skills"
  mkdir -p "$skills_dir"
  cleanup_legacy_skill_links "$skills_dir"
  for skill_dir in "$SOURCE_DIR"/skills/tm-*; do
    [ -f "$skill_dir/SKILL.md" ] || continue
    name="$(basename "$skill_dir")"
    target="$skills_dir/$name"
    mkdir -p "$target"
    create_link "$skill_dir/SKILL.md" "$target/SKILL.md"
    [ -d "$skill_dir/agents" ] && create_link "$skill_dir/agents" "$target/agents"
    echo "linked Claude skill: $name"
  done
}

case "$HOST" in
  codex) install_codex ;;
  claude) install_claude ;;
  auto)
    install_codex
    install_claude
    ;;
esac

mkdir -p "$SOURCE_DIR/context/records" "$SOURCE_DIR/context/wiki" "$SOURCE_DIR/context/registry"
echo "team-memory setup complete"
